@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  html {
    scroll-behavior: smooth;
  }

  body {
    @apply bg-base-100 text-base-content font-sans antialiased selection:bg-primary selection:text-primary-content;
    transition: background-color 0.5s ease, color 0.5s ease;
  }

  /* Animated Grain Texture Overlay */
  body::before {
    content: "";
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 50;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }

  h1, h2, h3, h4, h5, h6 {
    @apply font-display tracking-tight;
  }
}

@layer components {
  /* Ultra-refined Glassmorphism Card */
  .section-card {
    @apply relative bg-base-100/40 backdrop-blur-xl border border-base-content/5 rounded-2xl shadow-xl p-6 md:p-8 transition-all duration-500 overflow-hidden;
  }

  .section-card::before {
    content: '';
    @apply absolute inset-0 bg-gradient-to-b from-white/5 to-transparent opacity-0 transition-opacity duration-500 pointer-events-none;
  }

  .section-card:hover {
    @apply border-primary/30 shadow-2xl shadow-primary/5 -translate-y-1;
  }

  .section-card:hover::before {
    @apply opacity-100;
  }

  /* High-tech Badge */
  .skill-badge {
    @apply font-mono text-xs md:text-sm px-4 py-2 rounded-full border border-base-content/10 bg-base-200/50 text-base-content/80 hover:bg-primary hover:text-primary-content hover:border-primary transition-all duration-300 hover:shadow-lg hover:shadow-primary/20 hover:-translate-y-0.5 cursor-default;
  }

  .social-link {
    @apply inline-flex items-center px-5 py-2.5 rounded-xl border border-base-content/10 bg-base-100/50 backdrop-blur-sm text-base-content/90 font-medium hover:bg-primary hover:text-primary-content hover:border-primary transition-all duration-300 hover:shadow-lg hover:shadow-primary/20 hover:-translate-y-1;
  }

  .text-gradient {
    @apply bg-clip-text text-transparent bg-gradient-to-r from-primary via-secondary to-accent animate-gradient bg-[length:200%_auto];
  }
}

@layer utilities {
  .animate-gradient {
    animation: textGradient 5s ease infinite;
  }

  @keyframes textGradient {
    0%, 100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  .glass-nav {
    @apply bg-base-100/60 backdrop-blur-lg border-b border-base-content/5;
  }
}